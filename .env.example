# URL pública do site, sem barra no fim.
#
# Alimenta metadataBase, Open Graph, a tag canonical, o sitemap.xml e o
# robots.txt. Sem ela, o código cai no domínio de produção declarado em
# data/event.ts.
#
# Defina em preview/staging para que canonical e sitemap apontem para o próprio
# host: canonical apontando para produção faz o buscador ignorar o ambiente, e
# apontando errado tira a página do índice.
#
# Declarar a variável SEM valor (o padrão de quem cria a env na Vercel e deixa
# em branco) equivale a não declarar: o código trata string vazia como ausente e
# usa o domínio de produção. Host sem protocolo também serve — vira https://.
NEXT_PUBLIC_SITE_URL=https://www.corridaverde.com.br

# Lista de espera → CRM da Thomé & Santos. Só o servidor lê
# (app/api/lista-de-espera/route.ts); nada disso vai para o navegador.
#
# CRM_API_URL ...... raiz do CRM, sem barra no fim.
# CRM_API_TOKEN .... o token deste site no API_TOKENS do CRM
#                    (ex.: `corrida-verde:<segredo>` lá; só o segredo aqui).
# CRM_EVENT_SLUG ... o ID do evento no CRM — o UUID no fim do endereço da
#                    ficha (/events/<id>). O nome ficou "slug" por histórico;
#                    o id é o que vale porque o slug muda quando o evento é
#                    renomeado.
#
# Sem as três, o formulário responde erro de envio em vez de gravar. Preencha
# só em produção: em preview e dev, vazias, nenhum teste vira lead de verdade.
CRM_API_URL=
CRM_API_TOKEN=
CRM_EVENT_SLUG=

# Opcional: cópia de cada cadastro para o webhook do n8n (a planilha da LP
# original). Quem decide se o cadastro deu certo é o CRM.
WAITLIST_WEBHOOK_URL=
